# Copy to .env and adjust
DATABASE_URL=sqlite:///./crowd.db
# For Postgres: postgresql+psycopg2://user:pass@localhost:5432/crowd

SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Seed admin
ADMIN_EMAIL=admin@crowd.local
ADMIN_PASSWORD=admin123
ADMIN_NAME=Admin

# Set to 0 in production to skip demo employees / donors / plan
# SEED_DEMO=0

# Quality score weights for donor matcher
SCORE_TR_WEIGHT=40
SCORE_TRAFFIC_WEIGHT=20
SCORE_REFDOMAINS_WEIGHT=20
SCORE_BACKLINKS_WEIGHT=20
